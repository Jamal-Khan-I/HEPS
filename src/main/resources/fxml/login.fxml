<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<HBox style="-fx-background-color: #FFFFFF;" stylesheets="@../css/style.css"
      spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.LoginController">

    <!-- LEFT BRAND PANEL (FULL-HEIGHT SOFT TEAL #F0FDFA - PAGE 3) -->
    <VBox prefWidth="480.0" minWidth="420.0" maxWidth="560.0"
          style="-fx-background-color: #F0FDFA; -fx-border-color: #E5EAF1; -fx-border-width: 0 1px 0 0; -fx-padding: 48px 44px;"
          spacing="26.0">

        <!-- Brand Logo & Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <StackPane prefWidth="40.0" prefHeight="40.0" style="-fx-background-color: #0D9488; -fx-background-radius: 10px;">
                <SVGPath content="M3 12h4l3 8 4-16 3 8h4" style="-fx-stroke: #FFFFFF; -fx-stroke-width: 2.2; -fx-fill: transparent;" />
            </StackPane>
            <VBox spacing="1.0">
                <Label text="HEPS" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #0F172A;" />
                <Label text="City General Hospital Emergency Department" style="-fx-font-size: 12px; -fx-text-fill: #64748B;" />
            </VBox>
        </HBox>

        <!-- Headline & Value Proposition -->
        <VBox spacing="12.0" style="-fx-padding: 16px 0 0 0;">
            <Label text="Emergency care,&#10;prioritized in real time"
                   style="-fx-font-size: 30px; -fx-font-weight: 800; -fx-text-fill: #0F172A; -fx-line-spacing: 3px;" wrapText="true" />
            <Label text="Triage, 12-bay bed allocation and clinical order tracking for every patient, from arrival to discharge."
                   style="-fx-font-size: 14px; -fx-text-fill: #475569; -fx-line-spacing: 4px;" wrapText="true" />
        </VBox>

        <!-- Dynamic ECG Pulse Graphic -->
        <StackPane alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-padding: 8px 0;">
            <SVGPath content="M 0 35 L 70 35 L 85 8 L 105 60 L 125 18 L 135 42 L 145 35 L 360 35"
                     style="-fx-stroke: #0D9488; -fx-stroke-width: 2.6; -fx-fill: transparent; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;" />
        </StackPane>

        <Region VBox.vgrow="ALWAYS" />

        <!-- Security & Compliance Features -->
        <VBox spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-padding: 18px 20px; -fx-background-radius: 12px; -fx-border-color: #CCFBF1; -fx-border-width: 1px;">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane prefWidth="28.0" prefHeight="28.0" style="-fx-background-color: #F0FDFA; -fx-background-radius: 6px;">
                    <SVGPath content="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" style="-fx-stroke: #0D9488; -fx-stroke-width: 2; -fx-fill: transparent;" />
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="Role-based access &amp; audit trail" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
                    <Label text="Granular permissions for 5 clinical roles" style="-fx-font-size: 11.5px; -fx-text-fill: #64748B;" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane prefWidth="28.0" prefHeight="28.0" style="-fx-background-color: #F0FDFA; -fx-background-radius: 6px;">
                    <SVGPath content="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 6v6l4 2" style="-fx-stroke: #0D9488; -fx-stroke-width: 2; -fx-fill: transparent;" />
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="Live SLA tracking &amp; escalation" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
                    <Label text="National Early Warning Score 2 (NEWS2)" style="-fx-font-size: 11.5px; -fx-text-fill: #64748B;" />
                </VBox>
            </HBox>
        </VBox>

        <Label text="Hospital Emergency Priority System · v1.0 Enterprise" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" />
    </VBox>

    <!-- RIGHT SIGN IN WORKSPACE (FULL-HEIGHT WHITE, CENTERED FORM - PAGE 3) -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 32px 48px;">
        <VBox maxWidth="440.0" spacing="18.0" alignment="CENTER_LEFT">

            <!-- Sign In Header -->
            <VBox spacing="4.0">
                <Label text="Sign in" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #0F172A;" />
                <Label text="Use your hospital staff account credentials to access your clinical workstation." style="-fx-font-size: 13.5px; -fx-text-fill: #64748B;" wrapText="true" />
            </VBox>

            <!-- Error Banner -->
            <Label fx:id="lblError" visible="false" managed="false"
                   style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-font-weight: 600; -fx-border-color: #FECACA; -fx-border-radius: 8px;" />

            <!-- Username Input -->
            <VBox spacing="6.0">
                <Label text="Username" style="-fx-font-weight: 600; -fx-font-size: 13px; -fx-text-fill: #334155;" />
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 4px 12px;">
                    <SVGPath content="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" style="-fx-stroke: #94A3B8; -fx-stroke-width: 1.8; -fx-fill: transparent;" />
                    <TextField fx:id="txtUsername" promptText="e.g. nurse.priya" styleClass="search-pill-input" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- Password Input -->
            <VBox spacing="6.0">
                <Label text="Password" style="-fx-font-weight: 600; -fx-font-size: 13px; -fx-text-fill: #334155;" />
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 4px 12px;">
                    <SVGPath content="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zM7 11V7a5 5 0 0 1 10 0v4" style="-fx-stroke: #94A3B8; -fx-stroke-width: 1.8; -fx-fill: transparent;" />
                    <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="search-pill-input" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- Role Dropdown -->
            <VBox spacing="6.0">
                <Label text="Role" style="-fx-font-weight: 600; -fx-font-size: 13px; -fx-text-fill: #334155;" />
                <ComboBox fx:id="cmbRole" maxWidth="Infinity" prefHeight="42.0" styleClass="form-input" />
            </VBox>

            <!-- Sign In Button -->
            <Button fx:id="btnSignIn" text="Sign in to Workstation" defaultButton="true" onAction="#handleSignIn" maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 12px;" />

        </VBox>
    </VBox>

</HBox>
