<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-padding: 0 4px 20px 0;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.MassCasualtyController">

    <!-- HEADER & DISASTER STATUS BAR -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Mass casualty mode" />
            <Label styleClass="view-subtitle" text="START (Simple Triage and Rapid Treatment) disaster triage for mass surge incidents." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnToggleMci" onAction="#handleToggleMci" styleClass="btn-danger" text="🚨 Active MCI Mode (ON)" />
    </HBox>

    <!-- PROMINENT DISASTER SURGE BANNER -->
    <HBox fx:id="mciBanner" alignment="CENTER_LEFT" spacing="14.0"
          style="-fx-background-color: #FEE2E2; -fx-padding: 12px 18px; -fx-background-radius: 10px; -fx-border-color: #FECACA; -fx-border-radius: 10px;">
        <Label text="⚠️" style="-fx-font-size: 20px;" />
        <VBox spacing="2.0">
            <Label text="MASS CASUALTY SURGE PROTOCOL ACTIVE" style="-fx-font-size: 13.5px; -fx-font-weight: 800; -fx-text-fill: #991B1B;" />
            <Label text="Full administrative registration bypassed. 1-click START tags admitted directly to emergency queue." style="-fx-font-size: 11.5px; -fx-text-fill: #B91C1C;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblMciVictimCount" text="4 Disaster Victims Triaged" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #991B1B;" />
    </HBox>

    <!-- 4 START TRIAGE CARDS (RED, YELLOW, GREEN, BLACK) -->
    <HBox spacing="14.0">
        <VBox styleClass="kpi-card" style="-fx-background-color: #FEF2F2; -fx-border-color: #FECACA;" HBox.hgrow="ALWAYS">
            <Label text="RED · IMMEDIATE" style="-fx-font-size: 11.5px; -fx-font-weight: 800; -fx-text-fill: #B91C1C;" />
            <Label fx:id="lblRedCount" text="1" styleClass="kpi-value" style="-fx-text-fill: #B91C1C;" />
            <Label text="RR &gt; 30, no radial pulse, cannot follow commands" style="-fx-font-size: 11px; -fx-text-fill: #991B1B;" wrapText="true" />
        </VBox>

        <VBox styleClass="kpi-card" style="-fx-background-color: #FEFCE8; -fx-border-color: #FEF08A;" HBox.hgrow="ALWAYS">
            <Label text="YELLOW · DELAYED" style="-fx-font-size: 11.5px; -fx-font-weight: 800; -fx-text-fill: #A16207;" />
            <Label fx:id="lblYellowCount" text="2" styleClass="kpi-value" style="-fx-text-fill: #A16207;" />
            <Label text="Serious, non-ambulatory, but stable vitals" style="-fx-font-size: 11px; -fx-text-fill: #854D0E;" wrapText="true" />
        </VBox>

        <VBox styleClass="kpi-card" style="-fx-background-color: #F0FDF4; -fx-border-color: #BBF7D0;" HBox.hgrow="ALWAYS">
            <Label text="GREEN · MINOR" style="-fx-font-size: 11.5px; -fx-font-weight: 800; -fx-text-fill: #15803D;" />
            <Label fx:id="lblGreenCount" text="1" styleClass="kpi-value" style="-fx-text-fill: #15803D;" />
            <Label text="Walking wounded, minor injuries" style="-fx-font-size: 11px; -fx-text-fill: #166534;" wrapText="true" />
        </VBox>

        <VBox styleClass="kpi-card" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;" HBox.hgrow="ALWAYS">
            <Label text="BLACK · DECEASED" style="-fx-font-size: 11.5px; -fx-font-weight: 800; -fx-text-fill: #0F172A;" />
            <Label fx:id="lblBlackCount" text="0" styleClass="kpi-value" style="-fx-text-fill: #0F172A;" />
            <Label text="No spontaneous respiration after airway opening" style="-fx-font-size: 11px; -fx-text-fill: #475569;" wrapText="true" />
        </VBox>
    </HBox>

    <!-- RAPID 10-SECOND INTAKE FORM & VICTIMS LOG -->
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">

        <!-- RAPID INTAKE FORM (LEFT) -->
        <VBox prefWidth="380.0" minWidth="340.0" styleClass="modern-table-card" spacing="12.0">
            <Label text="Rapid 10-Second Disaster Intake" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />

            <VBox spacing="4.0">
                <Label text="Victim Identifier / Tag:" styleClass="form-field-label" />
                <TextField fx:id="txtMciIdentifier" promptText="e.g. Unknown male, ~40s, blue shirt" styleClass="form-input" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Estimated Demographics:" styleClass="form-field-label" />
                <HBox spacing="10.0">
                    <TextField fx:id="txtMciAge" prefWidth="100.0" promptText="Age (est.)" styleClass="form-input" />
                    <ComboBox fx:id="cmbMciGender" prefWidth="140.0" styleClass="filter-combo-pill" />
                </HBox>
            </VBox>

            <VBox spacing="4.0">
                <Label text="Injuries / Blast Severity:" styleClass="form-field-label" />
                <TextField fx:id="txtMciInjuries" promptText="e.g. Crush injury left arm, traumatic amputation" styleClass="form-input" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="START Triage Category:" styleClass="form-field-label" />
                <fx:define>
                    <ToggleGroup fx:id="startTagGroup" />
                </fx:define>
                <HBox spacing="8.0">
                    <RadioButton fx:id="rbRed" text="RED" toggleGroup="$startTagGroup" selected="true" style="-fx-text-fill: #B91C1C; -fx-font-weight: 700;" />
                    <RadioButton fx:id="rbYellow" text="YELLOW" toggleGroup="$startTagGroup" style="-fx-text-fill: #A16207; -fx-font-weight: 700;" />
                    <RadioButton fx:id="rbGreen" text="GREEN" toggleGroup="$startTagGroup" style="-fx-text-fill: #15803D; -fx-font-weight: 700;" />
                    <RadioButton fx:id="rbBlack" text="BLACK" toggleGroup="$startTagGroup" style="-fx-text-fill: #0F172A; -fx-font-weight: 700;" />
                </HBox>
            </VBox>

            <VBox spacing="4.0">
                <Label text="Designated Holding Area / Bay:" styleClass="form-field-label" />
                <ComboBox fx:id="cmbMciBay" prefWidth="280.0" styleClass="filter-combo-pill" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#handleRapidAdmit" styleClass="btn-danger" maxWidth="Infinity" text="⚡ Rapid Admit to Queue (Immediate)" />
        </VBox>

        <!-- DISASTER VICTIMS ROSTER (RIGHT) -->
        <VBox styleClass="modern-table-card" spacing="12.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label text="Triaged Disaster Victims Log" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRefreshRoster" styleClass="btn-secondary" text="🔄 Refresh" />
            </HBox>

            <TableView fx:id="tableMciVictims" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colTag" prefWidth="100.0" minWidth="85.0" text="TAG" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colTime" prefWidth="90.0" minWidth="80.0" text="TIME" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colIdentifier" prefWidth="300.0" minWidth="200.0" text="PATIENT IDENTIFIER" />
                    <TableColumn fx:id="colLocation" prefWidth="180.0" minWidth="150.0" text="HOLDING AREA / BAY" style="-fx-alignment: CENTER;" />
                </columns>
            </TableView>
        </VBox>

    </HBox>

</VBox>
