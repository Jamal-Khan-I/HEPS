<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-padding: 0 4px 20px 0;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.AdminController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Admin" />
            <Label styleClass="view-subtitle" text="System administration, staff role management, duty roster, bay resources, and compliance audit trail." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#handleRefreshAll" styleClass="btn-secondary" text="Refresh All" />
    </HBox>

    <!-- ADMIN TABPANE -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="modern-tab-pane">

        <!-- TAB 1: USERS & ROLES -->
        <Tab text="Staff &amp; Role Management">
            <VBox spacing="12.0" style="-fx-padding: 16px;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Authorized Hospital Staff Accounts" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleCreateUserDialog" styleClass="btn-primary" text="+ Add New Staff User" />
                </HBox>

                <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colUserId" prefWidth="60.0" minWidth="50.0" text="ID" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colUsername" prefWidth="150.0" minWidth="120.0" text="USERNAME" />
                        <TableColumn fx:id="colUserFullName" prefWidth="200.0" minWidth="150.0" text="FULL NAME" />
                        <TableColumn fx:id="colUserRole" prefWidth="160.0" minWidth="130.0" text="ASSIGNED ROLE" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colUserStatus" prefWidth="120.0" minWidth="90.0" text="STATUS" style="-fx-alignment: CENTER;" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 2: DOCTOR DUTY ROSTER -->
        <Tab text="Doctors &amp; Duty Roster">
            <VBox spacing="12.0" style="-fx-padding: 16px;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Emergency Physician Roster &amp; Active Workload" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Doctor status directly controls automated patient routing" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                </HBox>

                <TableView fx:id="tableDoctors" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colDocId" prefWidth="60.0" minWidth="50.0" text="ID" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colDocName" prefWidth="220.0" minWidth="160.0" text="PHYSICIAN NAME" />
                        <TableColumn fx:id="colDocSpecialty" prefWidth="180.0" minWidth="130.0" text="SPECIALTY" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colDocStatus" prefWidth="150.0" minWidth="110.0" text="DUTY STATUS" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colDocAction" prefWidth="160.0" minWidth="120.0" text="DUTY TOGGLE" style="-fx-alignment: CENTER;" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 3: BAY MANAGEMENT -->
        <Tab text="Emergency Bays &amp; Beds">
            <VBox spacing="12.0" style="-fx-padding: 16px;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Physical Capacity &amp; Resource Allocation" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleClearAllCleaning" styleClass="btn-modern-pill-secondary" text="Force-Clear All Cleaning Bays" />
                </HBox>

                <TableView fx:id="tableBays" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colBayId" prefWidth="60.0" minWidth="50.0" text="ID" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colBayName" prefWidth="180.0" minWidth="130.0" text="BAY / BED NAME" />
                        <TableColumn fx:id="colBayType" prefWidth="160.0" minWidth="120.0" text="ZONE / TYPE" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colBayStatus" prefWidth="140.0" minWidth="110.0" text="CURRENT STATUS" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colBayPatient" prefWidth="200.0" minWidth="150.0" text="OCCUPYING PATIENT" />
                        <TableColumn fx:id="colBayAction" prefWidth="160.0" minWidth="130.0" text="MAINTENANCE" style="-fx-alignment: CENTER;" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 4: COMPLIANCE AUDIT TRAIL (Page 18) -->
        <Tab text="Compliance Audit Trail">
            <VBox spacing="12.0" style="-fx-padding: 16px;">
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="filter-pill-bar">
                    <Label text="Search Audit:" styleClass="filter-label" />
                    <TextField fx:id="txtSearchAudit" prefWidth="250.0" promptText="Filter by user, action, patient..." styleClass="search-pill-input" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Immutable Medical-Legal Audit Trail" style="-fx-font-size: 11px; -fx-text-fill: #64748B; -fx-font-weight: 600;" />
                </HBox>

                <TableView fx:id="tableAudit" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colAuditTimestamp" prefWidth="140.0" minWidth="120.0" text="TIMESTAMP" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colAuditUser" prefWidth="130.0" minWidth="100.0" text="STAFF USER" />
                        <TableColumn fx:id="colAuditRole" prefWidth="130.0" minWidth="100.0" text="ROLE" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colAuditAction" prefWidth="180.0" minWidth="130.0" text="ACTION EVENT" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colAuditPatient" prefWidth="120.0" minWidth="90.0" text="PATIENT TOKEN" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colAuditDetails" prefWidth="320.0" minWidth="200.0" text="CLINICAL / SYSTEM DETAILS" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>

</VBox>
