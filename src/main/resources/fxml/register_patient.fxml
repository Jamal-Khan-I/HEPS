<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.RegisterPatientController">

    <!-- PAGE HEADER -->
    <VBox spacing="2.0">
        <Label styleClass="view-title" text="Register Patient" />
        <Label styleClass="view-subtitle" text="Record patient details and assign treatment priority." />
    </VBox>

    <!-- CENTERED REGISTRATION FORM CARD -->
    <VBox alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <VBox styleClass="panel" maxWidth="840.0" spacing="18.0">

            <!-- Group 1: Personal Details -->
            <VBox spacing="10.0">
                <Label text="Personal Details" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />

                <GridPane hgap="16.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <!-- Full Name -->
                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label styleClass="form-label" text="Full Name" />
                        <TextField fx:id="txtFullName" promptText="e.g. Ramesh Chandra" />
                    </VBox>

                    <!-- Contact Phone -->
                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label styleClass="form-label" text="Contact Number" />
                        <TextField fx:id="txtPhone" promptText="10-digit phone number" />
                    </VBox>

                    <!-- Age -->
                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label styleClass="form-label" text="Age" />
                        <TextField fx:id="txtAge" promptText="Years" />
                    </VBox>

                    <!-- Gender -->
                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label styleClass="form-label" text="Gender" />
                        <ComboBox fx:id="cmbGender" maxWidth="Infinity" />
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Group 2: Visit Details -->
            <VBox spacing="10.0">
                <Label text="Visit Details" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />

                <GridPane hgap="16.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <!-- Emergency Level -->
                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label styleClass="form-label" text="Emergency Level" />
                            <Label text="ℹ" style="-fx-text-fill: #0284C7; -fx-font-size: 11px; -fx-cursor: hand;">
                                <tooltip>
                                    <Tooltip text="Critical: immediate life threat&#10;High: severe emergency/fracture&#10;Medium: acute distress/pain&#10;Low: minor condition" />
                                </tooltip>
                            </Label>
                        </HBox>
                        <ComboBox fx:id="cmbEmergencyLevel" maxWidth="Infinity" />
                    </VBox>

                    <!-- Priority Level Clinical Note -->
                    <VBox alignment="CENTER_LEFT" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label styleClass="form-label" text="Priority Guidance" />
                        <Label fx:id="lblLevelDescription" styleClass="form-note" wrapText="true" />
                    </VBox>
                </GridPane>

                <VBox spacing="4.0">
                    <Label styleClass="form-label" text="Presenting Complaint" />
                    <TextArea fx:id="txtSymptoms" prefRowCount="3"
                              promptText="Describe presenting symptoms, clinical observation, or injury mechanism..."
                              wrapText="true" />
                </VBox>
            </VBox>

            <!-- Quiet note & Actions -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 8px 0 0 0;">
                <Label fx:id="lblPreviewToken" styleClass="form-note" text="A token number is assigned after registration." />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleClearForm" styleClass="btn-secondary" text="Clear" />
                <Button fx:id="btnRegister" onAction="#handleRegisterPatient" styleClass="btn-primary" text="Register Patient" />
            </HBox>

            <!-- Hidden compatibility label -->
            <Label fx:id="lblFormMessage" visible="false" managed="false" />
        </VBox>
    </VBox>

</VBox>
