<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-padding: 0 4px 20px 0;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.BayBoardController">

    <!-- HEADER & STATS BAR -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Bay board" />
            <Label styleClass="view-subtitle" text="Real-time occupancy, sanitization timers, and bed allocation across 12 ED bays." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <!-- SUMMARY STATS CHIPS -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <StackPane styleClass="counter-pill">
                <Label fx:id="lblTotalBays" text="12 Total Bays" styleClass="counter-pill-text" />
            </StackPane>
            <StackPane styleClass="counter-pill" style="-fx-background-color: #FEE2E2; -fx-border-color: #FECACA;">
                <Label fx:id="lblOccupiedBays" text="8 Occupied" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #B91C1C;" />
            </StackPane>
            <StackPane styleClass="counter-pill" style="-fx-background-color: #DCFCE7; -fx-border-color: #BBF7D0;">
                <Label fx:id="lblFreeBays" text="3 Free" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #15803D;" />
            </StackPane>
            <StackPane styleClass="counter-pill" style="-fx-background-color: #FEF9C3; -fx-border-color: #FEF08A;">
                <Label fx:id="lblCleaningBays" text="1 Cleaning" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #A16207;" />
            </StackPane>
            <Button onAction="#handleRefresh" styleClass="btn-modern-pill-secondary" text="Refresh" />
        </HBox>
    </HBox>

    <!-- ZONE FILTER BAR -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-pill-bar">
        <Button fx:id="btnFilterAll" onAction="#filterAll" styleClass="filter-tab-pill-active" text="All Bays (12)" />
        <Button fx:id="btnFilterResus" onAction="#filterResus" styleClass="filter-tab-pill" text="Resus &amp; Trauma (2)" />
        <Button fx:id="btnFilterAcute" onAction="#filterAcute" styleClass="filter-tab-pill" text="Acute Care (2)" />
        <Button fx:id="btnFilterObs" onAction="#filterObs" styleClass="filter-tab-pill" text="Observation (6)" />
        <Button fx:id="btnFilterFast" onAction="#filterFast" styleClass="filter-tab-pill" text="Fast Track &amp; Ambulatory (2)" />

        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="txtBaySearch" prefWidth="200.0" promptText="Search bay or patient..." styleClass="search-pill-input" />
    </HBox>

    <!-- 12-BAY CARDS SCROLLABLE GRID -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="bayGrid" hgap="16.0" vgap="16.0" style="-fx-padding: 4px 2px 20px 2px;">
            <!-- Bay cards populated dynamically by BayBoardController -->
        </FlowPane>
    </ScrollPane>

</VBox>
