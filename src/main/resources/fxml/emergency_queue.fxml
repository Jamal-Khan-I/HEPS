<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" style="-fx-padding: 0 4px 20px 0;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.EmergencyQueueController">

    <!-- HEADER & ACTION BAR -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Emergency Priority Queue" />
            <Label styleClass="view-subtitle" text="Real-time Min-Heap priority scheduling with automatic wait-time escalation." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <!-- ESCALATION SCAN BUTTON -->
        <Button fx:id="btnScanEscalations" onAction="#handleScanEscalations" styleClass="btn-secondary" text="⚡ Scan Wait Escalations" />

        <!-- BEGIN NEXT PATIENT (PRIMARY ACTION) -->
        <Button fx:id="btnServeHead" onAction="#handleServeNext" styleClass="btn-primary" text="Begin Treatment →" />
    </HBox>

    <!-- FLOATING MAIN CARD CONTAINER -->
    <VBox styleClass="modern-table-card" spacing="14.0" VBox.vgrow="ALWAYS">

        <!-- MODERN FILTER ROW -->
        <HBox alignment="CENTER_LEFT" styleClass="filter-pill-bar" spacing="14.0">
            <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="search-pill-box">
                <Label text="🔍" style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" />
                <TextField fx:id="txtSearch" prefWidth="220.0" promptText="Search token or patient..." styleClass="search-pill-input" />
            </HBox>

            <Label text="Urgency:" styleClass="filter-label" />
            <ComboBox fx:id="cmbFilterPriority" prefWidth="130.0" styleClass="filter-combo-pill" />

            <Label text="Specialty:" styleClass="filter-label" />
            <ComboBox fx:id="cmbFilterSpecialty" prefWidth="160.0" styleClass="filter-combo-pill" />

            <Region HBox.hgrow="ALWAYS" />

            <StackPane styleClass="counter-pill">
                <Label fx:id="lblQueueCounter" text="0 Patients Waiting" styleClass="counter-pill-text" />
            </StackPane>
            <Button onAction="#refreshQueue" styleClass="btn-secondary" text="🔄 Refresh" />
        </HBox>

        <!-- QUEUE TABLE VIEW (SPACIOUS COLUMN WIDTHS - NO CUT-OFFS) -->
        <TableView fx:id="queueTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPosition" prefWidth="48.0" text="#" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colToken" prefWidth="120.0" text="TOKEN" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colName" prefWidth="160.0" text="PATIENT NAME" />
                <TableColumn fx:id="colAge" prefWidth="55.0" text="AGE" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colPriority" prefWidth="110.0" text="PRIORITY" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colBay" prefWidth="190.0" text="ASSIGNED BAY" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colSpecialty" prefWidth="160.0" text="SPECIALTY" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colDoctor" prefWidth="150.0" text="ASSIGNED DOCTOR" />
                <TableColumn fx:id="colWaitTime" prefWidth="145.0" text="WAIT / TARGET SLA" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colVitals" prefWidth="180.0" text="PHYSIOLOGICAL VITALS" />
                <TableColumn fx:id="colSymptoms" prefWidth="220.0" text="PRESENTING COMPLAINT" />
            </columns>
        </TableView>

        <!-- SELECTED PATIENT ACTION DRAWER -->
        <HBox alignment="CENTER_LEFT" styleClass="selected-patient-pill-drawer" spacing="14.0">
            <StackPane styleClass="selected-pill-badge" minWidth="-Infinity">
                <Label text="Selected Patient" styleClass="selected-pill-badge-text" />
            </StackPane>
            <Label fx:id="lblSelectedInfo" text="Select a patient in the table to view details or begin treatment."
                   styleClass="selected-info-text" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnPrintTicket" onAction="#handlePrintTicket" styleClass="btn-modern-pill-secondary" text="🖨️ Print Triage Slip" minWidth="-Infinity" />
            <Button fx:id="btnServeSelected" onAction="#handleServeSelected" styleClass="btn-modern-pill-primary" text="Begin Treatment →" minWidth="-Infinity" />
        </HBox>

    </VBox>

</VBox>
