<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.EmergencyQueueController">

    <!-- Header & Primary Action -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Live Emergency Triage Queue" />
            <Label styleClass="view-subtitle" text="Active waiting patients ordered strictly by PriorityQueue priority rules (CRITICAL &gt; HIGH &gt; MEDIUM &gt; LOW)" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <!-- SERVE NEXT PATIENT ACTION -->
        <Button fx:id="btnServeHead" onAction="#handleServeNext" styleClass="btn-serve" text="SERVE NEXT PATIENT (HEAD)" />
    </HBox>

    <!-- SEARCH & FILTER CONTROLS -->
    <HBox alignment="CENTER_LEFT" styleClass="card" spacing="14.0" style="-fx-padding: 12px 18px;">
        <Label styleClass="form-label" text="Search Queue:" />
        <TextField fx:id="txtSearch" prefWidth="240.0" promptText="Filter by Token, Name, Symptoms..." />

        <Label styleClass="form-label" text="Filter Urgency:" />
        <ComboBox fx:id="cmbFilterPriority" prefWidth="160.0" promptText="All Priorities" />

        <Region HBox.hgrow="ALWAYS" />

        <!-- Queue Summary Counter -->
        <Label fx:id="lblQueueCounter" text="Showing 0 Patients" style="-fx-font-weight: bold; -fx-text-fill: #0F766E;" />

        <Button onAction="#refreshQueue" styleClass="btn-secondary" text="Refresh Queue" />
    </HBox>

    <!-- MAIN QUEUE TABLE VIEW -->
    <TableView fx:id="queueTable" VBox.vgrow="ALWAYS" prefHeight="380.0">
        <columns>
            <TableColumn fx:id="colPosition" prefWidth="65.0" text="Queue #" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colToken" prefWidth="130.0" text="Token No" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colName" prefWidth="180.0" text="Patient Full Name" />
            <TableColumn fx:id="colAge" prefWidth="60.0" text="Age" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colPriority" prefWidth="120.0" text="Emergency Level" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colSymptoms" prefWidth="320.0" text="Clinical Symptoms / Presenting Complaint" />
            <TableColumn fx:id="colArrival" prefWidth="170.0" text="Arrival Time" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- SELECTED PATIENT QUICK INSPECT BAR -->
    <HBox alignment="CENTER_LEFT" styleClass="card" spacing="16.0" style="-fx-padding: 12px 18px; -fx-background-color: #F1F5F9;">
        <Label text="MANUAL CLINICIAN OVERRIDE:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
        <Label fx:id="lblSelectedInfo" text="Select a WAITING patient in the table to admit via manual clinician override."
               style="-fx-font-size: 13px; -fx-text-fill: #1E293B; -fx-font-weight: 600;" HBox.hgrow="ALWAYS" wrapText="true" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnServeSelected" onAction="#handleServeSelected" styleClass="btn-primary" text="Admit Selected to Treatment" />
    </HBox>

</VBox>
