<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.EmergencyQueueController">

    <!-- HEADER & PRIMARY ACTION -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Emergency Queue" />
            <Label styleClass="view-subtitle" text="Patients awaiting treatment, ordered by urgency." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <!-- BEGIN NEXT PATIENT (PRIMARY RED ACTION) -->
        <Button fx:id="btnServeHead" onAction="#handleServeNext" styleClass="btn-critical" text="Begin Treatment" />
    </HBox>

    <!-- COMPACT FILTER ROW -->
    <HBox alignment="CENTER_LEFT" styleClass="panel" spacing="12.0" style="-fx-padding: 10px 16px;">
        <Label styleClass="form-label" text="Search:" />
        <TextField fx:id="txtSearch" prefWidth="250.0" promptText="Search token or patient" />

        <Label styleClass="form-label" text="Urgency:" />
        <ComboBox fx:id="cmbFilterPriority" prefWidth="150.0" />

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblQueueCounter" text="0 Patients Waiting" style="-fx-font-weight: 600; -fx-text-fill: #475569;" />
        <Button onAction="#refreshQueue" styleClass="btn-secondary" text="Refresh" />
    </HBox>

    <!-- QUEUE TABLE VIEW -->
    <TableView fx:id="queueTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPosition" prefWidth="55.0" text="#" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colToken" prefWidth="120.0" text="Token" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colName" prefWidth="180.0" text="Patient Name" />
            <TableColumn fx:id="colAge" prefWidth="55.0" text="Age" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colPriority" prefWidth="110.0" text="Priority" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colSymptoms" prefWidth="320.0" text="Presenting Complaint" />
            <TableColumn fx:id="colArrival" prefWidth="160.0" text="Arrival Time" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- SELECTED PATIENT ACTION DRAWER -->
    <HBox alignment="CENTER_LEFT" styleClass="panel" spacing="16.0" style="-fx-padding: 12px 18px; -fx-background-color: #FFFFFF;">
        <Label text="Selected:" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
        <Label fx:id="lblSelectedInfo" text="Select a patient in the table to view details or begin treatment."
               style="-fx-font-size: 13px; -fx-text-fill: #334155;" HBox.hgrow="ALWAYS" wrapText="true" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnServeSelected" onAction="#handleServeSelected" styleClass="btn-primary" text="Begin Treatment" />
    </HBox>

</VBox>
