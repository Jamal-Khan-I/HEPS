<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.DashboardController">

    <!-- Title & Refresh Header -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Emergency Triage Dashboard" />
            <Label styleClass="view-subtitle" text="Emergency department metrics and PriorityQueue status" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnQuickRegister" onAction="#handleQuickRegister" styleClass="btn-primary" text="Register New Patient" />
        <Button onAction="#refreshData" styleClass="btn-secondary" text="Refresh" />
    </HBox>

    <!-- KPI STATISTIC CARDS -->
    <HBox spacing="16.0">
        <!-- Card 1: Total Waiting -->
        <VBox styleClass="card, card-stat" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="WAITING PATIENTS" />
            <Label fx:id="lblTotalWaiting" styleClass="stat-value, stat-active" text="0" />
            <Label text="Currently in PriorityQueue" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" />
        </VBox>

        <!-- Card 2: Critical Waiting -->
        <VBox styleClass="card, card-stat" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="CRITICAL URGENCY" />
            <Label fx:id="lblCriticalWaiting" styleClass="stat-value, stat-critical" text="0" />
            <Label text="Highest clinical urgency" style="-fx-text-fill: #DC2626; -fx-font-size: 11px; -fx-font-weight: bold;" />
        </VBox>

        <!-- Card 3: In Treatment -->
        <VBox styleClass="card, card-stat" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="IN TREATMENT" />
            <Label fx:id="lblInTreatment" styleClass="stat-value, stat-urgent" text="0" />
            <Label text="Active clinical consultations" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" />
        </VBox>

        <!-- Card 4: Completed Today -->
        <VBox styleClass="card, card-stat" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="COMPLETED TODAY" />
            <Label fx:id="lblCompletedToday" styleClass="stat-value, stat-done" text="0" />
            <Label text="Treated and discharged" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" />
        </VBox>
    </HBox>

    <!-- NEXT UP PATIENT BANNER (QUEUE HEAD) -->
    <VBox fx:id="nextPatientBanner" styleClass="banner-next-patient" spacing="8.0">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="banner-title" text="HIGHEST PRIORITY PATIENT (QUEUE HEAD)" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblNextBadge" styleClass="badge, badge-critical" text="CRITICAL" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label fx:id="lblNextToken" style="-fx-text-fill: #BAE6FD; -fx-font-weight: bold; -fx-font-size: 18px;" text="TK-2026-0005" />
                    <Label fx:id="lblNextName" styleClass="banner-patient-name" text="Vikramaditya Rao (Demo)" />
                    <Label fx:id="lblNextAge" style="-fx-text-fill: #E0F2FE; -fx-font-size: 16px;" text="(Age: 54)" />
                </HBox>
                <Label fx:id="lblNextSymptoms" styleClass="banner-patient-details" text="Symptoms: Sudden onset facial drooping, left arm weakness" />
                <Label fx:id="lblNextArrival" style="-fx-text-fill: #BAE6FD; -fx-font-size: 12px;" text="Arrival: 14-09-2026 09:15:00" />
            </VBox>

            <Button fx:id="btnServeNextQuick" onAction="#handleServeNext" styleClass="btn-serve" text="SERVE PATIENT NOW" />
        </HBox>
    </VBox>

    <!-- ACTIVE QUEUE PREVIEW TABLE -->
    <VBox styleClass="card" spacing="12.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label text="LIVE EMERGENCY QUEUE PREVIEW (PRIORITY ORDER)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleViewFullQueue" styleClass="btn-secondary" text="View Full Queue Table" />
        </HBox>

        <TableView fx:id="previewTable" prefHeight="240.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPos" prefWidth="60.0" text="Pos" />
                <TableColumn fx:id="colToken" prefWidth="120.0" text="Token" />
                <TableColumn fx:id="colName" prefWidth="180.0" text="Patient Name" />
                <TableColumn fx:id="colAge" prefWidth="60.0" text="Age" />
                <TableColumn fx:id="colPriority" prefWidth="110.0" text="Urgency" />
                <TableColumn fx:id="colSymptoms" prefWidth="300.0" text="Clinical Symptoms" />
                <TableColumn fx:id="colArrival" prefWidth="160.0" text="Arrival Time" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
