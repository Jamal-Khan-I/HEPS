<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.DashboardController">

    <!-- PAGE HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Overview" />
            <Label styleClass="view-subtitle" text="Emergency department activity" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnQuickRegister" onAction="#handleQuickRegister" styleClass="btn-primary" text="Register Patient" />
        <Button onAction="#refreshData" styleClass="btn-secondary" text="Refresh" />
    </HBox>

    <!-- 3 COMPACT SUMMARY CARDS ONLY -->
    <HBox spacing="14.0">
        <!-- Card 1: Waiting -->
        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label styleClass="summary-label" text="WAITING" />
            <Label fx:id="lblTotalWaiting" styleClass="summary-value" text="0" />
            <Label styleClass="summary-subtext" text="Patients awaiting triage or care" />
        </VBox>

        <!-- Card 2: Critical -->
        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label styleClass="summary-label" text="CRITICAL" />
            <Label fx:id="lblCriticalWaiting" styleClass="summary-value-critical" text="0" />
            <Label styleClass="summary-subtext" text="Requiring immediate resuscitation" />
        </VBox>

        <!-- Card 3: In Treatment -->
        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label styleClass="summary-label" text="IN TREATMENT" />
            <Label fx:id="lblInTreatment" styleClass="summary-value" text="0" />
            <Label styleClass="summary-subtext" text="Currently in emergency treatment bays" />
        </VBox>
    </HBox>

    <!-- NEXT PATIENT PANEL -->
    <VBox fx:id="nextPatientBanner" styleClass="panel, next-patient-card" spacing="8.0">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="next-patient-header" text="Next Patient to Treat" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblNextBadge" styleClass="badge, badge-critical" text="CRITICAL" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="lblNextToken" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0369A1;" text="TK-2026-0005" />
                    <Label fx:id="lblNextName" styleClass="next-patient-name" text="Vikramaditya Rao" />
                    <Label fx:id="lblNextAge" styleClass="next-patient-meta" text="(Age 54, Male)" />
                    <Label fx:id="lblNextArrival" styleClass="next-patient-meta" text="• Arrived 09:15" />
                </HBox>
                <Label fx:id="lblNextSymptoms" styleClass="next-patient-complaint"
                       text="Sudden facial weakness, difficulty speaking, right-side mobility deficit"
                       wrapText="true" maxHeight="38.0" />
            </VBox>

            <Button fx:id="btnServeNextQuick" onAction="#handleServeNext" styleClass="btn-critical" text="Begin Treatment" />
        </HBox>
    </VBox>

    <!-- COMPACT WAITING QUEUE TABLE PREVIEW -->
    <VBox styleClass="panel" spacing="10.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label text="Waiting Queue Preview" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleViewFullQueue" styleClass="btn-secondary" text="View Full Queue" />
        </HBox>

        <TableView fx:id="previewTable" prefHeight="260.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPos" prefWidth="50.0" text="#" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colToken" prefWidth="120.0" text="Token" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colName" prefWidth="170.0" text="Patient Name" />
                <TableColumn fx:id="colAge" minWidth="55.0" prefWidth="60.0" text="Age" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colPriority" prefWidth="105.0" text="Priority" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colSymptoms" prefWidth="300.0" text="Presenting Complaint" />
                <TableColumn fx:id="colArrival" prefWidth="150.0" text="Arrival Time" style="-fx-alignment: CENTER;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
