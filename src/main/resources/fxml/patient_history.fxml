<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.PatientHistoryController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Patient Records &amp; Clinical History" />
            <Label styleClass="view-subtitle" text="Search, filter, and inspect emergency department records and treatment outcomes" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCompleteTreatmentAction" onAction="#handleCompleteSelected" styleClass="btn-success" text="Complete Treatment / Add Notes" />
        <Button onAction="#refreshHistory" styleClass="btn-secondary" text="Refresh" />
    </HBox>

    <!-- SEARCH & FILTER BAR -->
    <HBox alignment="CENTER_LEFT" styleClass="card" spacing="12.0" style="-fx-padding: 12px 18px;">
        <Label styleClass="form-label" text="Search:" />
        <TextField fx:id="txtSearch" prefWidth="220.0" promptText="Token, Name, or Phone..." />

        <Label styleClass="form-label" text="Emergency Level:" />
        <ComboBox fx:id="cmbLevelFilter" prefWidth="140.0" promptText="All Levels" />

        <Label styleClass="form-label" text="Status:" />
        <ComboBox fx:id="cmbStatusFilter" prefWidth="150.0" promptText="All Statuses" />

        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleSearch" styleClass="btn-primary" text="Search" />
        <Button onAction="#handleResetFilters" styleClass="btn-secondary" text="Reset" />
    </HBox>

    <!-- HISTORY TABLE VIEW -->
    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colToken" prefWidth="120.0" text="Token No" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colName" prefWidth="180.0" text="Full Name" />
            <TableColumn fx:id="colAge" prefWidth="55.0" text="Age" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colGender" prefWidth="75.0" text="Gender" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colPhone" prefWidth="130.0" text="Phone Number" />
            <TableColumn fx:id="colLevel" prefWidth="110.0" text="Urgency" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colArrival" prefWidth="160.0" text="Arrival Time" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- RECORD INSPECTION DRAWER / CARD -->
    <VBox fx:id="detailsCard" styleClass="card" spacing="10.0" style="-fx-background-color: #F8FAFC;">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label text="PATIENT CLINICAL &amp; TREATMENT RECORD:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #0F766E;" />
            <Label fx:id="lblSelectedTokenAndName" text="Select any patient above to inspect full clinical history"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblDetailStatus" styleClass="badge, status-completed" text="STATUS" visible="false" />
        </HBox>

        <HBox spacing="20.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Triage Clinical Symptoms:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;" />
                <Label fx:id="lblDetailSymptoms" text="-" style="-fx-font-size: 13px; -fx-text-fill: #1E293B;" wrapText="true" />
            </VBox>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Attending Doctor &amp; Treatment Notes:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;" />
                <Label fx:id="lblDetailTreatmentNotes" text="No treatment documentation recorded yet." style="-fx-font-size: 13px; -fx-text-fill: #1E293B;" wrapText="true" />
            </VBox>
        </HBox>
    </VBox>

</VBox>
