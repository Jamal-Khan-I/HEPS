<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="18.0" style="-fx-padding: 0 4px 20px 0;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.PatientHistoryController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Patient Records &amp; Clinical History" />
            <Label styleClass="view-subtitle" text="Search, inspect diagnosis logs, and complete active patient encounters." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCompleteTreatmentAction" disable="true" onAction="#handleCompleteSelected"
                styleClass="btn-primary" text="Complete Treatment" />
    </HBox>

    <!-- MAIN FLOATING CARD CONTAINER -->
    <VBox styleClass="modern-table-card" spacing="14.0" VBox.vgrow="ALWAYS">

        <!-- FILTER ROW -->
        <HBox alignment="CENTER_LEFT" styleClass="filter-pill-bar" spacing="14.0">
            <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="search-pill-box">
                <Label text="" style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" />
                <TextField fx:id="txtSearch" prefWidth="240.0" promptText="Search token, name, phone..." styleClass="search-pill-input" />
            </HBox>

            <Label text="Priority:" styleClass="filter-label" />
            <ComboBox fx:id="cmbLevelFilter" prefWidth="130.0" styleClass="filter-combo-pill" />

            <Label text="Status:" styleClass="filter-label" />
            <ComboBox fx:id="cmbStatusFilter" prefWidth="140.0" styleClass="filter-combo-pill" />

            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnDeletePatient" onAction="#handleDeletePatientRecord" styleClass="btn-secondary" text="Delete"
                    style="-fx-text-fill: #DC2626; -fx-border-color: #FECACA; -fx-background-color: #FEF2F2; -fx-font-weight: 600;">
                <graphic>
                    <SVGPath content="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6"
                             style="-fx-stroke: #DC2626; -fx-stroke-width: 1.6; -fx-fill: transparent;" />
                </graphic>
            </Button>
            <Button onAction="#refreshHistory" styleClass="btn-secondary" text="Refresh" />
        </HBox>

        <!-- PATIENT RECORDS TABLE VIEW -->
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colToken" prefWidth="120.0" minWidth="95.0" text="TOKEN" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colName" prefWidth="170.0" minWidth="120.0" text="FULL NAME" />
                <TableColumn fx:id="colAge" prefWidth="55.0" minWidth="45.0" text="AGE" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colGender" prefWidth="75.0" minWidth="65.0" text="GENDER" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colLevel" prefWidth="110.0" minWidth="90.0" text="PRIORITY" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colBay" prefWidth="180.0" minWidth="130.0" text="ASSIGNED BAY" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colStatus" prefWidth="125.0" minWidth="95.0" text="STATUS" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colPhone" prefWidth="130.0" minWidth="105.0" text="PHONE NUMBER" />
                <TableColumn fx:id="colArrival" prefWidth="150.0" minWidth="120.0" text="ARRIVAL TIME" style="-fx-alignment: CENTER;" />
            </columns>
        </TableView>

        <!-- SELECTED PATIENT DETAILS DRAWER -->
        <VBox fx:id="detailsCard" styleClass="selected-patient-details-box" spacing="12.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane styleClass="selected-pill-badge" minWidth="-Infinity">
                    <Label text="Patient Record" styleClass="selected-pill-badge-text" />
                </StackPane>
                <Label fx:id="lblSelectedTokenAndName" text="Select a patient above to inspect clinical history."
                       styleClass="selected-record-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnPrintHistoryTicket" onAction="#handlePrintTicket" styleClass="btn-secondary" text="Print Slip" visible="false" minWidth="-Infinity" />
                <Label fx:id="lblDetailStatus" styleClass="badge-pill, badge-completed" text="Status" visible="false" minWidth="-Infinity" />
            </HBox>

            <HBox spacing="16.0">
                <!-- Left: Clinical Triage & Vitals -->
                <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="patient-detail-subcard">
                    <Label text="Clinical Triage &amp; Vitals Profile" styleClass="patient-subcard-title" />
                    <Label fx:id="lblDetailSymptoms" text="Select a patient from the table above to view clinical complaint and recorded vitals." styleClass="patient-subcard-body" wrapText="true" />
                </VBox>

                <!-- Right: Treatment Records & Doctor Notes -->
                <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="patient-detail-subcard">
                    <Label text="Treatment Record &amp; Notes" styleClass="patient-subcard-title" />
                    <Label fx:id="lblDetailTreatmentNotes" text="Select a patient to view treatment history or complete active care." styleClass="patient-subcard-body" wrapText="true" />
                </VBox>
            </HBox>
        </VBox>

    </VBox>

</VBox>
