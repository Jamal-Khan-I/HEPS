<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospital.priority.controller.PatientHistoryController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label styleClass="view-title" text="Patient Records" />
            <Label styleClass="view-subtitle" text="Search and review patient visits." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCompleteTreatmentAction" onAction="#handleCompleteSelected" styleClass="btn-success" text="Complete Treatment" />
    </HBox>

    <!-- SINGLE COMPACT FILTER ROW -->
    <HBox alignment="CENTER_LEFT" styleClass="panel" spacing="12.0" style="-fx-padding: 10px 16px;">
        <Label styleClass="form-label" text="Search:" />
        <TextField fx:id="txtSearch" prefWidth="240.0" promptText="Search token, name, phone..." />

        <Label styleClass="form-label" text="Priority:" />
        <ComboBox fx:id="cmbLevelFilter" prefWidth="130.0" />

        <Label styleClass="form-label" text="Status:" />
        <ComboBox fx:id="cmbStatusFilter" prefWidth="140.0" />

        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#refreshHistory" styleClass="btn-secondary" text="Refresh" />
    </HBox>

    <!-- PATIENT RECORDS TABLE VIEW -->
    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colToken" prefWidth="110.0" text="Token" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colName" prefWidth="180.0" text="Full Name" />
            <TableColumn fx:id="colAge" prefWidth="55.0" text="Age" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colGender" prefWidth="75.0" text="Gender" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colPhone" prefWidth="130.0" text="Phone Number" />
            <TableColumn fx:id="colLevel" prefWidth="110.0" text="Priority" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colArrival" prefWidth="160.0" text="Arrival Time" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- SELECTED PATIENT DETAILS DRAWER -->
    <VBox fx:id="detailsCard" styleClass="panel" spacing="8.0" style="-fx-padding: 14px 18px;">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label text="Selected Patient Details:" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #0F172A;" />
            <Label fx:id="lblSelectedTokenAndName" text="Select a patient above to inspect clinical history."
                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1E293B;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblDetailStatus" styleClass="badge, status-completed" text="Status" visible="false" />
        </HBox>

        <HBox spacing="24.0">
            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                <Label text="Presenting Complaint:" styleClass="form-label" />
                <Label fx:id="lblDetailSymptoms" text="-" style="-fx-font-size: 13px; -fx-text-fill: #334155;" wrapText="true" />
            </VBox>

            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                <Label text="Treatment &amp; Discharge Notes:" styleClass="form-label" />
                <Label fx:id="lblDetailTreatmentNotes" text="No treatment documentation recorded." style="-fx-font-size: 13px; -fx-text-fill: #334155;" wrapText="true" />
            </VBox>
        </HBox>
    </VBox>

</VBox>
